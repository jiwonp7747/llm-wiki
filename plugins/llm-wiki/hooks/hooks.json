{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${PLUGIN_ROOT}\" ] || exit 0; python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "if not \"%PLUGIN_ROOT%\"==\"\" py -3 \"%PLUGIN_ROOT%\\hooks\\session_start.py\"",
            "timeout": 10,
            "statusMessage": "Loading LLM Wiki context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${PLUGIN_ROOT}\" ] || exit 0; python3 \"${PLUGIN_ROOT}/hooks/stop_validate.py\"",
            "commandWindows": "if not \"%PLUGIN_ROOT%\"==\"\" py -3 \"%PLUGIN_ROOT%\\hooks\\stop_validate.py\"",
            "timeout": 30,
            "statusMessage": "Checking LLM Wiki structure"
          }
        ]
      }
    ]
  }
}
