{
  "name": "llm-wiki",
  "version": "0.1.0+codex.20260924151340",
  "description": "Build and maintain persistent Markdown knowledge bases from immutable sources.",
  "author": {
    "name": "jiwonp7747",
    "email": "angry9908@gmail.com",
    "url": "https://github.com/jiwonp7747"
  },
  "homepage": "https://github.com/jiwonp7747/llm-wiki",
  "repository": "https://github.com/jiwonp7747/llm-wiki",
  "license": "MIT",
  "keywords": [
    "llm",
    "wiki",
    "knowledge-base",
    "markdown",
    "codex"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "LLM Wiki",
    "shortDescription": "Persistent, source-backed Markdown knowledge bases",
    "longDescription": "Turn immutable source material into a maintained Markdown wiki with repeatable ingest, query, indexing, logging, and lint workflows.",
    "developerName": "jiwonp7747",
    "category": "Developer Tools",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/jiwonp7747/llm-wiki",
    "defaultPrompt": [
      "Initialize an LLM Wiki in this project.",
      "Ingest this source into the project wiki.",
      "Lint the project wiki and report knowledge gaps."
    ]
  },
  "mcpServers": {
    "llm-wiki": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "${PLUGIN_ROOT}",
        "python",
        "${PLUGIN_ROOT}/mcp/server.py"
      ]
    }
  }
}
